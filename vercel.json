{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__p="
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__p=:path*"
    }
  ]
}
